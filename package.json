{
  "name": "yunjia-coastal-circuit",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/web-racer/ --outDir=dist-pages",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "models:showroom": "node scripts/build-showroom.mjs",
    "models:home-coast": "node --import tsx scripts/build-home-coast.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name web-racer --branch main",
    "prepare:edgeone": "node scripts/prepare-edgeone.mjs",
    "deploy:edgeone": "npm run build && npm run prepare:edgeone && npx --yes edgeone@1.6.47 makers deploy dist-edgeone --name cloudcape-rally --site china --area overseas --env production --skip-ai-gateway-sync --json"
  },
  "dependencies": {
    "jolt-physics": "^0.35.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "gltfpack": "1.0.0",
    "sharp": "0.34.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "4.73.0"
  }
}
