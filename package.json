    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "gltfpack": "1.0.0",
    "sharp": "0.34.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "4.73.0"
